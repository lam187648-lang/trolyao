# OpenRouter API Key - Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
ADMIN_API_TOKEN=replace_with_a_long_random_secret
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:3000,http://127.0.0.1:5500,https://lam187648.github.io

# Optional: Custom model (default: openai/gpt-4o-mini)
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: Site URL for OpenRouter analytics
# OPENROUTER_SITE_URL=https://lam187648.github.io/troly

# Optional: enable Pusher real-time events
# PUSHER_APP_ID=
# PUSHER_KEY=
# PUSHER_SECRET=
# PUSHER_CLUSTER=
