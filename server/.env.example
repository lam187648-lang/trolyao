# Required: OpenRouter API key. Never commit a real key.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: model and analytics URL
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_SITE_URL=https://lam187648-lang.github.io/trolyao/

# Optional Pusher realtime service. Leave unset to keep Pusher disabled.
# Rotate the previously exposed Pusher secret before configuring these values.
# PUSHER_APP_ID=your_app_id
# PUSHER_KEY=your_public_key
# PUSHER_SECRET=your_new_secret
# PUSHER_CLUSTER=your_cluster
